    {
      "id": 7,
      "type": "timeseries",
      "title": "Queue depth casino-bets",
      "description": "If 'ready' keeps growing, the Consumer cannot keep up or is down.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_detailed_queue_messages_ready{queue=\"casino-bets\"}",
          "legendFormat": "ready (waiting)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "rabbitmq_detailed_queue_messages_unacked{queue=\"casino-bets\"}",
          "legendFormat": "delivered, not yet acknowledged",
