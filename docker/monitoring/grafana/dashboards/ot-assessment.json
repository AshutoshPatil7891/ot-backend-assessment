    {
      "id": 11,
      "type": "timeseries",
      "title": "CPU use: API, Consumer and RabbitMQ (percent of one core)",
      "description": "100 percent = one full CPU core busy. API and Consumer: process CPU time. RabbitMQ: CPU time of the Erlang runtime.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"ot-api\"}[1m]) * 100",
          "legendFormat": "API",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "rate(process_cpu_seconds_total{job=\"ot-consumer\"}[1m]) * 100",
          "legendFormat": "Consumer",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "rate(erlang_vm_statistics_runtime_milliseconds{job=\"rabbitmq\"}[1m]) / 10",
          "legendFormat": "RabbitMQ",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
